# Foody Mobile App — copy to .env (this file is TEMPLATE, never commit .env)
# Backend URL — SINGLE source of truth, all data via API (no direct Firestore from UI)
# For physical device use your LAN IP: http://192.168.1.x:5000/api/v1
EXPO_PUBLIC_API_URL=http://localhost:5000/api/v1
EXPO_PUBLIC_MAGIC_LINK_REDIRECT=foody://auth/magic-link

# Firebase Web App — TEMPLATE ONLY (replace YOUR_* with real values from Firebase Console)
# Get these from Firebase Console > Project Settings > General > Your apps > Web app > Config
# NOTE: Firebase Web API keys are PUBLIC by design (they are not secrets), but .env is still gitignored for hygiene.
# SECURITY MODEL (API-only): Frontend uses Firebase CLIENT SDK ONLY for Auth (Email/Password, Google, Phone).
# All Firestore reads/writes for products/orders/addresses MUST go via backend API (src/api/*), NOT direct firestore.ts.
# If you leave these empty, app runs in API mock-token mode (backend customToken as Bearer).
EXPO_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID
EXPO_PUBLIC_FIREBASE_APP_ID=YOUR_APP_ID
EXPO_PUBLIC_FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID

# Google Sign-In (OAuth client IDs) — all end with *.apps.googleusercontent.com (NOT the Firebase API key)
# HOW TO GET:
# 1) WEB: Firebase Console (project YOUR_PROJECT) → Authentication → Sign-in method → Google
#          → expand "Web SDK configuration" → copy "Web client ID"
# 2) iOS: Google Cloud Console → Credentials → + Create → OAuth client ID → iOS → Bundle ID: com.foody.app
# 3) Android: Google Cloud Console → Credentials → + Create → OAuth client ID → Android
#            → Package: com.foody.app + SHA-1 (npx eas credentials, or keytool on debug.keystore)
# Tip: in Expo Go you can reuse the WEB client id for both iosClientId and androidClientId.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=YOUR_GOOGLE_WEB_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=YOUR_GOOGLE_IOS_CLIENT_ID.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=YOUR_GOOGLE_ANDROID_CLIENT_ID.apps.googleusercontent.com

# Optional: set to true to use Firebase Emulators locally
# EXPO_PUBLIC_USE_FIREBASE_EMULATOR=true
