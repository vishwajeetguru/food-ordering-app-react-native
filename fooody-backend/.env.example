# Foody Backend Environment Variables
# Copy this file to .env and fill required values

NODE_ENV=development
PORT=5000

# CORS - comma-separated origins or * for dev
CORS_ORIGIN=*

# ─────────────────────────────────────
# Firebase Admin SDK (choose ONE method)
# ─────────────────────────────────────
# Method 1: Service account JSON file path (recommended for local dev)
# Download from Firebase Console > Project Settings > Service Accounts > Generate new private key
# FIREBASE_SERVICE_ACCOUNT_PATH=./service-account.json

# Method 2: Individual env vars (for production / Vercel / Railway)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# ─────────────────────────────────────
# Magic Link
# ─────────────────────────────────────
# Deep link for mobile (Expo) + fallback web URL
# For Expo: foody://auth/magic-link  or  https://yourapp.com/auth/magic-link
MAGIC_LINK_REDIRECT_URL=foody://auth/magic-link
MAGIC_LINK_EXPIRATION_MINUTES=15

# ─────────────────────────────────────
# OTP (Email)
# ─────────────────────────────────────
OTP_EXPIRATION_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
OTP_LENGTH=6
OTP_MAX_RESENDS_PER_HOUR=5

# ─────────────────────────────────────
# Rate Limiting
# ─────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ─────────────────────────────────────
# Logging
# ─────────────────────────────────────
LOG_LEVEL=info
# debug | info | warn | error

# Optional: If Firebase Admin should be initialized via Application Default Credentials (gcloud), leave firebase vars empty and set GOOGLE_APPLICATION_CREDENTIALS

# ─────────────────────────────────────
# Email Delivery (OTP / Magic Link / Password Reset) — REQUIRED for production
# ─────────────────────────────────────
# Dev mode: OTP/magic links are only printed to console.
# Production: emails are NOT sent until configured AND wired into
# src/services/otp/providers/email-otp.provider.ts
#
# Option A — SMTP (Gmail app password, Brevo, Mailgun, Zoho, etc.)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="Foody <no-reply@foody.app>"
#
# Option B — SendGrid
# SENDGRID_API_KEY=
# SENDGRID_FROM_EMAIL=no-reply@foody.app

# ─────────────────────────────────────
# Production-only overrides (when NODE_ENV=production)
# ─────────────────────────────────────
# CORS_ORIGIN=https://foody.app,https://admin.foody.app   (must NOT be * in prod)
# MAGIC_LINK_REDIRECT_URL=https://foody.app/auth/magic-link
